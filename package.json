{
    "name": "cville-kitchen",
    "version": "1.0.0",
    "description": "Charlottesville Kitchen - Mutual Aid Organization Website",
    "private": true,
    "packageManager": "pnpm@11.10.0",
    "scripts": {
        "dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\"",
        "dev:frontend": "pnpm --filter @cville-kitchen/frontend dev",
        "dev:backend": "pnpm --filter @cville-kitchen/backend dev",
        "build": "pnpm build:backend && pnpm build:frontend",
        "build:frontend": "pnpm --filter @cville-kitchen/frontend build",
        "build:backend": "pnpm --filter @cville-kitchen/backend build",
        "start": "concurrently \"pnpm start:backend\" \"pnpm start:frontend\"",
        "start:frontend": "pnpm --filter @cville-kitchen/frontend start",
        "start:backend": "pnpm --filter @cville-kitchen/backend start",
        "lint": "pnpm --filter @cville-kitchen/frontend lint && pnpm --filter @cville-kitchen/backend lint",
        "lint:frontend": "pnpm --filter @cville-kitchen/frontend lint",
        "lint:backend": "pnpm --filter @cville-kitchen/backend lint",
        "type-check": "pnpm --filter @cville-kitchen/frontend type-check && pnpm --filter @cville-kitchen/backend type-check",
        "type-check:frontend": "pnpm --filter @cville-kitchen/frontend type-check",
        "type-check:backend": "pnpm --filter @cville-kitchen/backend type-check",
        "clean": "rm -rf frontend/.next backend/dist frontend/node_modules backend/node_modules node_modules"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    },
    "engines": {
        "node": ">=20.9.0",
        "pnpm": ">=9.0.0"
    },
    "author": "Evan White",
    "license": "AGPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/evanWh1te/cville-kitchen-website.git"
    },
    "keywords": [
        "mutual-aid",
        "community",
        "nextjs",
        "express",
        "typescript"
    ]
}
